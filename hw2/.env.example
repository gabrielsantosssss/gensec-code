# Copy this file to .env and fill in your own values.
# .env is already excluded from git by the repo's .gitignore - never commit real keys.

# Google AI Studio API key (only needed if you switch away from Vertex AI embeddings)
GOOGLE_API_KEY=

# Google Cloud project ID, used for Vertex AI embeddings (matches the lab setup)
GOOGLE_CLOUD_PROJECT=

# Chat model name passed to ChatGoogleGenerativeAI
GOOGLE_MODEL=gemini-3.6-flash
