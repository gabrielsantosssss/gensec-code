# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=your-gemini-api-key
RAG_MODEL=gemini-3.8-flash

# Optional
# FLASK_SECRET_KEY=a-long-random-string   (random per run if unset)
# FLASK_DEBUG=false                        (keep false; never true on a shared network)
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# RAG_TOP_K=4
